  try {
    var bar = document.querySelector('header.site-bar');
    if (bar) bar.parentNode.removeChild(bar);
    var learn = document.getElementById('learn');
    if (learn) {
      var h = learn.querySelector('h2');
      if (h) h.parentNode.removeChild(h);
      var nav = learn.querySelector('nav.related');
      if (nav) nav.parentNode.removeChild(nav);
      var foot = learn.querySelector('p.meta-foot');
      if (foot) foot.parentNode.removeChild(foot);
    }
  } catch (e) {}
})();
