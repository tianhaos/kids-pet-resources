␀␀␀h␀␀␀␀␀\␀␀#version 100
uniform float _impeller_y_flip;


struct FrameInfo
{
    mat4 mvp;
};

uniform FrameInfo frame_info;

attribute vec2 vertices;
varying vec2 v_dst_texture_coords;
attribute vec2 dst_texture_coords;
varying vec2 v_src_texture_coords;
attribute vec2 src_texture_coords;

void _impeller_user_main()
{
